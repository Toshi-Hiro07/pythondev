     "text": [
      "送料として350円かかります\n",
      "送料込みの価格は570です。\n"
     ]
    }
   ],
   "source": [
    "fee = int(input(\"税抜価格を入力してください\"))\n",
    "tax=round(fee*0.10)\n",
    "total=round(fee+tax)\n",
    "if total>=2000:\n",
    "    print(\"送料は無料です\")\n",
    "    print(\"送料込みの価格は\"+str(total)+\"です。\")\n",
    "if total<2000:\n",
    "    total=total+350\n",
    "    print(\"送料として350円かかります\")\n",
    "    print(\"送料込みの価格は\"+str(total)+\"です。\")\n"
   ]
  }
 ],
