   "source": [
    "#@title 九九のリストを作成する \n",
    "kuku = [[v * h for h in range(1, 10)] for v in range(1, 10)]\n",
    "\n",
    "#@title 九九の表を表示する \n",
    "for row in kuku:\n",
    "    for val in row:\n",
    "        print(f\"{val:3d}\", end=\"\")\n",
    "    print(\"\")"
   ]
  }
