   ],
   "source": [
    "total = 0  \n",
    "count = 0  \n",
    "\n",
    "while True:\n",
    "    score = input(\"点数を入力してください（終了するには -1 を入力）：\")\n",
    "    if score == \"-1\":\n",
    "        break\n",
    "    total += float(score)  \n",
    "    count += 1\n",
    "\n",
    "if count > 0:\n",
    "    average = total / count\n",
    "    print(\"平均点は \" + str(round(average,1)) + \" 点です。\")\n"
   ]
  }
 ],
