   "source": [
    "N, M = map(int, input().split())\n",
    "\n",
    "total = 0\n",
    "# 続く N-1 行：隣り合う車の車間距離 A_i\n",
    "for _ in range(N - 1):\n",
    "    Ai = int(input())\n",
    "    if Ai <= M:\n",
    "        total += Ai\n",
    "\n",
    "print(total)"
   ]
  }
 ],
